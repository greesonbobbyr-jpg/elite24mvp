// Elite24MVP — Prisma schema
//
// Data layer for the team-private basketball development app (see CLAUDE.md).
// SQLite is an MVP/testing choice; keep the data layer swappable for a hosted
// database later (CLAUDE.md section 6).
//
// Phase 1 introduces Team, User, and PlayerProfile; Phase 3 adds JournalEntry
// and PointsLedger; Phase 4 adds Quest and QuestLog; Phase 5 adds Notification
// and NotificationRead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma migrations run over a DIRECT (session) connection; the app uses the
  // transaction pooler. Both are Supabase pooler URLs (IPv4).
  directUrl = env("DIRECT_URL")
}

// Hierarchy-rebuild roles. COACH is the LEGACY login-level value (User.role) and
// is retired at decommission (Stage 6); the five real roles are used by
// Membership.role (team scope; never ORG_ADMIN — app-enforced) and
// RoleAssignment.role (org scope).
enum Role {
  COACH // legacy — do not use in new code
  PLAYER
  ORG_ADMIN
  HEAD_COACH
  ASSISTANT_COACH
  GENERAL_MANAGER
}

// Fixed-window rate-limit counters (lib/ratelimit.ts). DB-backed so limits hold
// across serverless instances with no extra infra. `key` encodes
// scope:identifier:windowIndex; rows are pruned opportunistically.
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  createdAt DateTime @default(now())
}

// ============================================================================
// HIERARCHY REBUILD (Stage 0 — additive; see plans/REVAMP docs).
// Organization → Season → Team. `organizationId` is the AUTHORIZATION ANCHOR:
// every permission check compares org ids, so Program/Division can be inserted
// later as optional grouping FKs without touching a single permission check.
// ============================================================================

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  seasons         Season[]
  teams           Team[]
  quests          Quest[]
  roleAssignments RoleAssignment[]
  programs        Program[]
}

// Grouping layers (structure Chunk 1). DISPLAY/ROLLUP ONLY — never traversed
// by a permission check; authorization stays anchored on organizationId.
// Program and Division PERSIST across seasons ("12U in 2026" = the 12U
// division's teams whose memberships are in the 2026 season). Layers with a
// single entry are hidden by the UI (progressive disclosure — a display rule,
// never a data rule; every org always has at least a default of each).
model Program {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  divisions Division[]

  @@index([organizationId, sortOrder])
}

model Division {
  id        Int      @id @default(autoincrement())
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  teams Team[]

  @@index([programId, sortOrder])
}

model Season {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // "2026–27", "Summer 2026"
  startDate      DateTime?
  endDate        DateTime?
  // Exactly one current season per org — app-enforced transactionally (Prisma
  // can't express a partial unique); a test owns this invariant.
  isCurrent      Boolean      @default(true)
  createdAt      DateTime     @default(now())

  memberships Membership[]

  @@index([organizationId, isCurrent])
}

// The PERMANENT PERSON. Development data (journal, reviews, points, streaks)
// attaches here so it follows the athlete across teams and seasons. `userId` is
// nullable ON PURPOSE: a profile may exist before anyone logs into it (future
// roster-first / guardian flows).
model Profile {
  id     Int   @id @default(autoincrement())
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Identity ("card info" — the teammate-visible surface per the matrix)
  name         String
  photoUrl     String?
  // Card portrait (card redesign): background-removed cutout derived from
  // photoUrl (the original is never overwritten) + the Stage-4 normalization
  // metadata {version, faceBox, eyeY, headTopY, shoulderY, scale, tx, ty}.
  photoCutoutUrl String?
  photoMeta      Json?
  jerseyNumber Int? // preferred; Membership can override per team
  position     String?
  gradYear     Int?
  bio          String?
  heightInches Int?

  // Personal (owner-visible; Dream lives on the athlete's own Home)
  dream           String?
  favoritePlayer  String?
  favoriteTeam    String?
  highlightUrl    String?
  pointsPerGame   Float?
  reboundsPerGame Float?
  assistsPerGame  Float?

  // Career aggregates: careerPoints = Σ ALL ledger rows for this profile
  // (drives the card tier); streaks follow the person. Both kept in sync in
  // the same transaction as every ledger write (same discipline as today).
  careerPoints    Int     @default(0)
  currentStreak   Int     @default(0)
  bestStreak      Int     @default(0)
  lastCheckInDay  String?
  streakGraceUsed Boolean @default(false)

  // The setup gate: EVERYONE completes profile setup (players: Dream + basics;
  // staff: name/photo). Replaces PlayerProfile.onboardedAt at cutover.
  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())

  contact               ProfileContact?
  memberships           Membership[]
  roleAssignments       RoleAssignment[]
  journalEntries        JournalEntry[]
  dailyReviews          DailyReview[]
  mindsetTakeaways      MindsetTakeaway[]
  questLogs             QuestLog[]
  pointsLedger          PointsLedger[]
  notificationReads     NotificationRead[]
  messageReactions      MessageReaction[]
  authoredNotifications Notification[]    @relation("NotificationAuthorProfile")
  authoredMessages      TeamMessage[]     @relation("MessageAuthorProfile")
}

// Sensitive contact data — a SEPARATE table so it has a separate, permission-
// gated read path (ORG_ADMIN: full; staff: emergency fields only — lib/authz).
// Guardian fields exist for minors; a parent portal is a LATER initiative.
// NO medical/allergy fields, by decision.
model ProfileContact {
  id        Int     @id @default(autoincrement())
  profileId Int     @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  dob          DateTime?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  email        String?

  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  guardianEmail    String?

  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  // Audit only (plain id, no FK): who last touched it.
  updatedByProfileId Int?
  updatedAt          DateTime @updatedAt
}

// Participation of a person on a TEAM in a SEASON, with a role. Staff are on
// the roster too (HEAD_COACH / ASSISTANT_COACH / GENERAL_MANAGER memberships);
// team-scoped authority comes FROM membership. "Removing a player" ENDS the
// membership (endedAt) — it never deletes a User or Profile.
model Membership {
  id        Int     @id @default(autoincrement())
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  teamId    Int
  team      Team    @relation(fields: [teamId], references: [id])
  seasonId  Int
  season    Season  @relation(fields: [seasonId], references: [id])
  role      Role // PLAYER | HEAD_COACH | ASSISTANT_COACH | GENERAL_MANAGER (never ORG_ADMIN/COACH)

  jerseyNumber Int? // per-team override of Profile.jerseyNumber

  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  endedByProfileId Int? // audit only, no FK

  // Team-leaderboard cache: Σ ledger rows stamped with this membership; updated
  // in the SAME transaction as every ledger write.
  points Int @default(0)

  mindsetTakeaways MindsetTakeaway[]
  questLogs        QuestLog[]
  pointsLedger     PointsLedger[]

  @@unique([profileId, teamId, seasonId])
  @@index([teamId, seasonId, endedAt])
  @@index([profileId, endedAt])
}

// A role AT a scope. V1 uses this ONLY for ORG_ADMIN at org scope (team-scoped
// authority comes from Membership). `organizationId` is ALWAYS set — even for a
// future team-scoped grant — so "scope is always org-bounded" is structural.
model RoleAssignment {
  id             Int          @id @default(autoincrement())
  profileId      Int
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role           Role
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         Int? // plain id; set only for team-scoped grants (unused in v1)
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@unique([profileId, role, organizationId, teamId])
  @@index([profileId, revokedAt])
}

// A team is the private space a coach runs for their players.
//
// `parentId` is a nullable self-relation: a team can later belong to a larger
// grouping (conference / region) so leaderboards can be scoped to any level
// (CLAUDE.md section 3.5). It is intentionally unused in the UI for now — the
// app shows a single-team view — but the model must never hard-code "one team".
// STAGE 0: gains nullable organizationId (backfilled in Stage 1; parentId is
// retired at decommission, superseded by the org anchor).
model Team {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  // Stage 0 (nullable → backfilled → NOT NULL at decommission).
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  memberships    Membership[]

  // Grouping (Chunk 1): nullable during migration → backfilled → NOT NULL at a
  // later cleanup. Restrict: a division holding teams can't be deleted.
  divisionId Int?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  // IANA timezone for this team's calendar-day logic. Data-model prep: the app
  // currently uses the app-wide APP_TIMEZONE (lib/daykey); threading this value
  // through every todayKey() call site is a later refactor.
  timezone String @default("America/Chicago")

  // Coach-set hour (0-23, team-local) for the daily check-in Web Push reminder.
  // Null = reminders off. The cron sender matches it against the current hour
  // in `timezone` and only pushes to players who haven't checked in yet.
  checkInReminderHour Int?

  // Players join a team with this short code (generated at team creation, coach
  // can regenerate). Unique across teams. Null only for legacy rows.
  joinCode String? @unique

  // Team branding: logo + two team colors. Coach-editable in signup + settings.
  // logoUrl holds either a pasted URL or an uploaded image as a size-capped
  // `data:` URL (no file hosting — see app/components/TeamBrandingFields).
  // primary/secondary are hex values chosen from the curated lib/teamColors
  // palette (validated server-side). Both nullable — branding is optional.
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?

  // Future grouping hook (conference/region). Unused in the current UI.
  parentId Int?
  parent   Team?  @relation("TeamHierarchy", fields: [parentId], references: [id])
  children Team[] @relation("TeamHierarchy")

  users         User[]
  notifications Notification[]
  teamMessages  TeamMessage[]

  @@index([divisionId])
}

// A user is either a COACH (team admin) or a PLAYER. Both belong to one team.
// No password field yet: Phase 1 uses the dev user switcher for local testing,
// and real auth will be added with a vetted library in a later hardening phase
// (CLAUDE.md section 6).
model User {
  id        Int      @id @default(autoincrement())
  // Nullable: players sign up with a username + password only (no email — data
  // minimization for minors, CLAUDE.md §3.4). Coaches still have an email.
  email     String?  @unique
  name      String
  role      Role
  createdAt DateTime @default(now())

  // Credential auth (Auth.js credentials provider). Coaches log in by email now;
  // players by username in a later chunk — username added now to avoid a
  // re-migration. `passwordHash` is a bcrypt hash; null until a credential is set.
  passwordHash String?
  username     String? @unique

  // Optional profile photo — a size-capped `data:` URL. Coaches upload theirs in
  // Team Settings; players use PlayerProfile.photoUrl (via their Brand page). Both
  // render in the PlayerCard/avatar with an initials fallback.
  photoUrl String?
  // Card portrait cutout + normalization metadata (card redesign; see Profile).
  photoCutoutUrl String?
  photoMeta      Json?

  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

  // Players have a profile; coaches do not.
  profile PlayerProfile?

  // A player's daily check-ins, points history, and quest completions.
  journalEntries JournalEntry[]
  pointsLedger   PointsLedger[]
  questLogs      QuestLog[]
  mindsetTakeaways MindsetTakeaway[]
  dailyReviews   DailyReview[]

  // Notifications a coach has authored, and a player's read-confirmations.
  authoredNotifications Notification[]     @relation("NotificationAuthor")
  notificationReads     NotificationRead[]

  // Team message board posts this user has authored, and reactions they've made.
  teamMessages     TeamMessage[]
  messageReactions MessageReaction[]

  // Web Push subscriptions for the daily check-in reminder (player-owned).
  pushSubscriptions PushSubscription[]

  // Stage 0: the permanent person this login belongs to (1:1 for now).
  profileRecord Profile?
}

// One browser/device Web Push subscription. Endpoint is globally unique; a user
// may have several (phone + tablet). Dead endpoints (410/404 on send) are pruned
// by the cron sender. No PII beyond the push endpoint itself.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Player-only data: the required Dream plus structured "Your Brand" stats.
// Kept on a separate 1:1 model so the User model stays clean for both roles
// and we only collect what the loop needs (CLAUDE.md section 3.4).
model PlayerProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The Dream is required at onboarding and is the heart of the loop (section 2).
  dream String

  // Structured basketball stats (all optional; entered by the player).
  heightInches    Int?
  position        String?
  jerseyNumber    Int?
  pointsPerGame   Float?
  reboundsPerGame Float?
  assistsPerGame  Float?

  favoritePlayer String?
  favoriteTeam   String?

  // A single highlight reel — a PASTED LINK only (no upload/hosting, section 5).
  highlightUrl String?

  // Player photo: an uploaded image stored as a size-capped `data:` URL (same
  // in-field, no-hosting pattern as Team.logoUrl). Owner-only upload; null =
  // fall back to initials in the PlayerCard.
  photoUrl String?
  // Card portrait cutout + normalization metadata (card redesign; see Profile).
  photoCutoutUrl String?
  photoMeta      Json?

  // Convenience cache of the player's total points. The PointsLedger is the
  // source of truth; this is kept in sync in the same transaction as each
  // ledger write so a future leaderboard can read a single number quickly.
  points Int @default(0)

  // Check-in streak (lib/streaks.ts, advanced inside submitCheckIn's txn).
  // One missed day is absorbed by a grace "shield" (streakGraceUsed tracks
  // whether this streak already spent it); a second gap resets. Habit design:
  // punishing a single miss teaches quitting, not consistency.
  currentStreak   Int     @default(0)
  bestStreak      Int     @default(0)
  lastCheckInDay  String?
  streakGraceUsed Boolean @default(false)

  // Set when the player completes first-time onboarding (CLAUDE.md section 2).
  // Null = not yet onboarded. In the seed, a not-yet-onboarded player has no
  // PlayerProfile row at all; this timestamp marks completion explicitly.
  onboardedAt DateTime?

  createdAt DateTime @default(now())
}

// One row per daily check-in: the player's typed reflection for a calendar day.
// One per player per day (see @@unique). Typed text only — no photo upload and
// no AI grading (CLAUDE.md section 3.3).
model JournalEntry {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflection String
  day        String   // calendar day "YYYY-MM-DD" (server-local time)
  createdAt  DateTime @default(now())

  // Stage 0: person dimension (backfilled; becomes the key at decommission).
  profileId Int?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@unique([profileId, day])
  @@index([userId])
  @@index([profileId])
}

// Did the day's plan happen? The player's own honest read.
enum ReviewOutcome {
  YES
  PARTIAL
  NO
}

// The evening "Pro Review" — the closing step of the E24P cycle (Pro Plan →
// Pro Preview → Pro Perform → PRO REVIEW). One per player per day, only after
// that day's check-in exists (the review references the morning plan).
// PRIVACY: like the check-in reflection, `learned` and `noteToTomorrow` are
// PLAYER-PRIVATE — the coach may see THAT a review was done, never its text.
// `noteToTomorrow` resurfaces in the next morning's check-in (the investment
// that loads the next trigger).
model DailyReview {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day            String // "YYYY-MM-DD" (app-timezone, lib/daykey)
  outcome        ReviewOutcome
  learned        String // "What did you notice?"
  noteToTomorrow String?
  createdAt      DateTime      @default(now())

  // Stage 0: person dimension (author-only data, same posture as JournalEntry).
  profileId Int?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@unique([profileId, day])
  @@index([userId])
  @@index([profileId])
}

// One row per player per day: the "1-Minute Mindset" takeaway they wrote after
// the day's story. Keyed by (userId, day) like JournalEntry — the day ties it to
// that day's story (storyForDay is deterministic). An OPTIONAL daily reflection —
// it does NOT gate the check-in. Unlike the private check-in reflection, this is
// coach-visible BY DESIGN (shown on the coach drill-in).
model MindsetTakeaway {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  day       String   // "YYYY-MM-DD" (server-local time)
  createdAt DateTime @default(now())

  // Stage 0: person dimension + the AT-TIME membership stamp — coach visibility
  // is scoped to staff of the team the athlete was on THAT DAY (the stamp),
  // never past/future teams.
  profileId    Int?
  profile      Profile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id])

  @@unique([userId, day])
  @@unique([profileId, day])
  @@index([userId])
  @@index([membershipId])
}

// Where a points-earning event came from. New sources (quests, coach awards)
// are added here as the app grows, so they can be told apart.
enum PointsSource {
  DAILY_CHECK_IN
  QUEST
  COACH_ADJUSTMENT // a coach's manual +/- veto (with a reason); see coach/actions
  REVIEW // completing the evening Pro Review
}

// The points ledger is the source of truth for a player's points: one row per
// earning event. A player's total = the sum of their rows. PlayerProfile.points
// is a convenience cache kept in sync in the same transaction.
model PointsLedger {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  source    PointsSource
  createdAt DateTime     @default(now())

  // Stage 0: career dimension (tier) + team dimension (leaderboards).
  // membershipId is REQUIRED at write time for quest/coach-adjustment sources,
  // NULLABLE for check-ins/reviews earned with no active membership (offseason
  // — career points + streak keep working; counts toward no team board).
  profileId    Int?
  profile      Profile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id])

  // The quest completion that awarded this row (null for non-quest sources like
  // the daily check-in). 1:1 — set by logQuest, used by undoQuest. onDelete:
  // Cascade so undeleting a completion (deleting its QuestLog) removes this row.
  questLogId Int?      @unique
  questLog   QuestLog? @relation(fields: [questLogId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([profileId])
  @@index([membershipId, createdAt]) // weekly boards
}

// Daily quests are shared, global definitions for the MVP (not team-specific).
// PLACEHOLDER content lives in the seed; Gary replaces it later. Kept clean so a
// nullable teamId could be added later for team-specific quests (CLAUDE.md 3.5).
model Quest {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  points      Int
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  // A MEASURABLE quest (e.g. free throws out of 50). When set, the player
  // predicts their count before starting and logs the actual after — the
  // predicted-vs-actual gap trains self-assessment (calibration). Null = a
  // plain one-tap quest.
  targetCount Int?

  // Stage 0: quests become ORG-OWNED (global rows are cloned per org in the
  // backfill; nullable until decommission).
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  logs QuestLog[]

  @@index([organizationId, active])
}

// Whether a quest completion has been awarded. Defaults to APPROVED so points
// are earned immediately (no approval UI in this phase). PENDING leaves room for
// a future coach-approval flow without a schema change.
enum QuestStatus {
  PENDING
  APPROVED
}

// One row per player completing a quest on a calendar day. One per player per
// quest per day (see @@unique), mirroring the daily check-in pattern.
model QuestLog {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   Int
  quest     Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  day       String      // calendar day "YYYY-MM-DD" (app-timezone, lib/daykey)
  status    QuestStatus @default(APPROVED)
  createdAt DateTime    @default(now())

  // Predict-then-log for measurable quests (Quest.targetCount != null): the
  // player's predicted count (set at start, status PENDING) and the actual they
  // logged (set at completion, status → APPROVED). Both null for one-tap quests.
  predicted Int?
  actual    Int?

  // The points-ledger row this completion created (set by logQuest). Cascade-
  // deleted with the log on undo.
  pointsLedger PointsLedger?

  // Stage 0: person dimension + the membership the completion CREDITS. The
  // [profileId, questId, day] unique = one completion per PERSON per quest per
  // day, so context-switching can never double-dip points.
  profileId    Int?
  profile      Profile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id])

  @@unique([userId, questId, day])
  @@unique([profileId, questId, day])
  @@index([userId])
  @@index([questId])
  @@index([membershipId, day])
}

// A note a coach posts to their own team. Belongs to exactly one team
// (team-scoped, CLAUDE.md section 3.2). In-app only — no push or email.
model Notification {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("NotificationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  // Urgent "TIME OUT" takeover that covers a player's app until acknowledged
  // (acknowledgement reuses NotificationRead). Default = a normal notification.
  isTimeout Boolean  @default(false)
  createdAt DateTime @default(now())

  // Stage 0: author = person + ROLE SNAPSHOT for display ("Head Coach") —
  // snapshot instead of a membership FK so an ORG_ADMIN (no membership) can
  // post and display stays stable if their role later changes. SetNull so
  // posts survive a (rare, operator-only) person deletion.
  authorProfileId Int?
  authorProfile   Profile? @relation("NotificationAuthorProfile", fields: [authorProfileId], references: [id], onDelete: SetNull)
  authorRole      Role?

  reads NotificationRead[]

  @@index([teamId])
}

// A record that a specific player has confirmed reading a specific
// notification. One per player per notification (see @@unique).
model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  // Stage 0: reads are per-person.
  profileId Int?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@unique([notificationId, profileId])
  @@index([userId])
}

// A text post on a team's message board (CLAUDE.md §2/§3). Belongs to exactly
// one team (team-scoped, §3.2). Text only — no images/attachments. Soft-deleted
// via deletedAt for coach moderation / author removal (kept rather than hard-
// deleted so removals are auditable for a kids' space, §3.1).
// `type` is REGULAR for everyone's normal messages; the colored special types
// (Discussion/Challenge/Spotlight) are coach-only, enforced in the post action.
model TeamMessage {
  id        Int         @id @default(autoincrement())
  teamId    Int
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  type      MessageType @default(REGULAR)
  // References a curated GIF id from lib/gifs.ts (NOT a DB relation — the registry
  // lives in code). Validated against the registry server-side on every post, so a
  // message can never point at an arbitrary/external image. Null = no GIF.
  gifId     String?
  // Messenger-style reply: this message answers another message on the same team
  // (set + validated in postMessage). Null = not a reply. SetNull on parent delete
  // so a reply survives (the quote just shows "original removed").
  replyToId Int?
  replyTo   TeamMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   TeamMessage[] @relation("MessageReplies")
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  // Stage 0: author person + role snapshot (same reasoning as Notification).
  authorProfileId Int?
  authorProfile   Profile? @relation("MessageAuthorProfile", fields: [authorProfileId], references: [id], onDelete: SetNull)
  authorRole      Role?

  reactions MessageReaction[]

  @@index([teamId])
  @@index([replyToId])
}

enum MessageType {
  REGULAR
  DISCUSSION // blue  — "Discussion of the Day" (coach only)
  CHALLENGE  // green — "Challenge of the Week" (coach only)
  SPOTLIGHT  // red   — "Coach's Spotlight" (coach only)
}

enum ReactionType {
  THUMBS_UP
  HEART
  LAUGH
  WOW
  SAD
  PRAY
}

// A Messenger-style reaction by a team member on a board message. ONE reaction
// per user per message (see @@unique) — picking a new face replaces the old one.
// Team-scoped (verified in the action).
model MessageReaction {
  id           Int          @id @default(autoincrement())
  messageId    Int
  message      TeamMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType ReactionType
  createdAt    DateTime     @default(now())

  // Stage 0: reactions are per-person.
  profileId Int?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@unique([messageId, profileId])
  @@index([messageId])
}
